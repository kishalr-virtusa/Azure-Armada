// IaaS tier protected by Azure Site Recovery (ASR): a small "reports" VM in Region A, replicated to Region B.
// The DR Agent validates it with an ASR *test failover* into an isolated network (non-disruptive).
// Replication itself (fabrics, containers, policy, mappings, protected item) is configured by
// infra/scripts/asr.sh because those resources are asynchronous and must be created in order.

@description('Region A (source)')
param locationA string

@description('Region B (recovery)')
param locationB string

@description('Resource suffix')
param suffix string

@description('Project tag')
param projectTag string = 'dr-agent'

@secure()
@description('VM admin password (login is never needed; Run Command is used). Generated by up.sh.')
param adminPassword string

@description('VM size (Free Trial: B-series, 4 cores per region; ~$0.01/h)')
param vmSize string = 'Standard_B2als_v2' // 2 vCPU / 4 GB; Windows needs >1 GB

var tags = { project: projectTag, tier: 'iaas' }
var vmName = 'dra-vm-reports'

// Reports service: a tiny PowerShell HTTP listener on :8080 returning the VM's region (from IMDS), started at boot
// by a SYSTEM scheduled task. Windows is used because the ASR Linux agent only supports specific kernel builds.
var setupScript = '''
New-Item -ItemType Directory -Force -Path C:\reports | Out-Null
@'
$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add('http://+:8080/')
$listener.Start()
function Get-Region { try { Invoke-RestMethod -Headers @{Metadata='true'} -TimeoutSec 2 -Uri 'http://169.254.169.254/metadata/instance/compute/location?api-version=2021-02-01&format=text' } catch { 'unknown' } }
while ($true) {
  $ctx = $listener.GetContext()
  $body = @{ service = 'contoso-reports'; status = 'ok'; host = $env:COMPUTERNAME; region = (Get-Region) } | ConvertTo-Json -Compress
  $bytes = [Text.Encoding]::UTF8.GetBytes($body)
  $ctx.Response.ContentType = 'application/json'
  $ctx.Response.OutputStream.Write($bytes, 0, $bytes.Length)
  $ctx.Response.Close()
}
'@ | Set-Content -Encoding UTF8 C:\reports\app.ps1
$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -File C:\reports\app.ps1'
Register-ScheduledTask -TaskName 'ContosoReports' -Action $action -Trigger (New-ScheduledTaskTrigger -AtStartup) -User 'SYSTEM' -RunLevel Highest -Force | Out-Null
Start-ScheduledTask -TaskName 'ContosoReports'
Start-Sleep -Seconds 5
Invoke-RestMethod http://localhost:8080/health | ConvertTo-Json -Compress
'''

// ---------------------------------------------------------------- Region A: source VM
resource vnetA 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: 'dra-vnet-eas-${suffix}'
  location: locationA
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: [ '10.10.0.0/16' ] }
    subnets: [
      {
        name: 'default'
        properties: {
          addressPrefix: '10.10.1.0/24'
          // ASR's mobility agent needs outbound access to Azure endpoints (no NAT gateway: cost)
          defaultOutboundAccess: true
        }
      }
    ]
  }
}

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = {
  name: '${vmName}-nic'
  location: locationA
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          privateIPAllocationMethod: 'Dynamic'
          subnet: { id: vnetA.properties.subnets[0].id }
        }
      }
    ]
  }
}

resource vm 'Microsoft.Compute/virtualMachines@2024-07-01' = {
  name: vmName
  location: locationA
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    osProfile: {
      computerName: 'reports'
      adminUsername: 'draadmin'
      adminPassword: adminPassword
      windowsConfiguration: {
        provisionVMAgent: true
        enableAutomaticUpdates: false // no surprise reboots during a drill
        patchSettings: { patchMode: 'Manual' }
      }
    }
    storageProfile: {
      imageReference: {
        publisher: 'MicrosoftWindowsServer'
        offer: 'WindowsServer'
        sku: '2022-datacenter-core-smalldisk-g2'
        version: 'latest'
      }
      osDisk: {
        name: '${vmName}-osdisk'
        createOption: 'FromImage'
        managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        deleteOption: 'Delete'
      }
    }
    networkProfile: {
      networkInterfaces: [ { id: nic.id, properties: { deleteOption: 'Delete' } } ]
    }
    diagnosticsProfile: { bootDiagnostics: { enabled: true } } // managed boot diagnostics (free)
  }
}

resource setup 'Microsoft.Compute/virtualMachines/runCommands@2024-07-01' = {
  parent: vm
  name: 'install-reports-service'
  location: locationA
  properties: {
    source: { script: setupScript }
    timeoutInSeconds: 900
    asyncExecution: false
  }
}

// ASR cache storage must be in the source region
resource cache 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: 'draasrcache${suffix}'
  location: locationA
  tags: tags
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
  }
}

// ---------------------------------------------------------------- Region B: vault + recovery networks
resource vault 'Microsoft.RecoveryServices/vaults@2024-04-01' = {
  name: 'dra-rsv-${suffix}'
  location: locationB
  tags: tags
  sku: { name: 'RS0', tier: 'Standard' }
  properties: {
    publicNetworkAccess: 'Enabled'
  }
}

resource vnetB 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: 'dra-vnet-sea-${suffix}'
  location: locationB
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: [ '10.20.0.0/16' ] }
    subnets: [ { name: 'default', properties: { addressPrefix: '10.20.1.0/24' } } ]
  }
}

// isolated network for test failovers: no peering, no route to production
resource vnetTest 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: 'dra-vnet-sea-test-${suffix}'
  location: locationB
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: [ '10.30.0.0/16' ] }
    subnets: [ { name: 'default', properties: { addressPrefix: '10.30.1.0/24' } } ]
  }
}

output vmName string = vm.name
output vmId string = vm.id
output osDiskId string = vm.properties.storageProfile.osDisk.managedDisk.id
output vaultName string = vault.name
output cacheStorageId string = cache.id
output vnetAId string = vnetA.id
output vnetBId string = vnetB.id
output vnetTestId string = vnetTest.id
