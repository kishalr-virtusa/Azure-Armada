# DR Agent Console - Environment Variables
# Copy this file to .env and fill in the values

# Azure subscription and resource identifiers
AZURE_SUBSCRIPTION_ID=
WORKLOAD_RG=rg-dra-workload
CONTROL_RG=rg-dra-control

# Workload app identifiers (from Bicep outputs)
WEBAPP_A_NAME=
WEBAPP_B_NAME=
WEBAPP_A_RG=rg-dra-workload
WEBAPP_B_RG=rg-dra-workload

# Traffic Manager
TM_PROFILE_NAME=
TM_RG=rg-dra-workload
TM_FQDN=

# SQL Failover Group
SQL_SERVER_A=
SQL_SERVER_B=
SQL_FOG_NAME=
SQL_RG=rg-dra-workload

# Azure OpenAI (via AI Foundry)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Storage account for exercise state
STORAGE_ACCOUNT_NAME=
STORAGE_TABLE_ENDPOINT=

# Console authentication
CONSOLE_PASSCODE=

# Email notifications via Azure Communication Services
ACS_CONNECTION_STRING=
ACS_SENDER=
NOTIFY_EMAIL_TO=

# Application Insights (optional for local dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=
