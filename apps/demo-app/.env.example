# Contoso Payments Demo App - Environment Variables
# Copy this file to .env and fill in the values

# Region identifier (set by App Service app settings)
REGION_NAME=centralindia

# Required app setting (intentionally missing in Region B for demo)
PAYMENT_PROVIDER=stripe

# SQL Database connection via Failover Group listener
SQL_SERVER=dra-fog-xxxx.database.windows.net
SQL_DB=paymentsdb
SQL_USER=sqladmin
SQL_PASSWORD=

# Application Insights (optional for local dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=
