<mxCell id="notes" value="&lt;b&gt;Where it runs&lt;/b&gt;&lt;br&gt;Full drills run in staging or isolated test networks; production gets continuous read-only validation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scope:&lt;/b&gt; DR &lt;i&gt;validation&lt;/i&gt; — prove the plan works, on a schedule, with evidence." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#F2C661;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingRight=12;spacingTop=10;" parent="L_notes" vertex="1"><mxGeometry x="185" y="1308" width="700" height="132" as="geometry"/></mxCell>
