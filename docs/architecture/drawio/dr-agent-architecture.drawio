<mxCell id="step5" value="&lt;b style='font-size:14px'&gt;Traffic Manager switch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Region A endpoint off; customers are routed to Region B (priority 2)." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingLeft=46;spacingTop=14;spacingRight=12;" parent="L_notes" vertex="1"><mxGeometry x="558" y="1070" width="310" height="165" as="geometry"/></mxCell>
