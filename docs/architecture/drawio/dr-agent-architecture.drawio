<mxCell id="flow_title" value="&lt;b&gt;DR DRILL FLOW&lt;/b&gt; — one exercise, end-to-end (numbers match the badges on the diagram)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=13;fontColor=#0078D4;spacing=0;" parent="L_notes" vertex="1"><mxGeometry x="228" y="845" width="900" height="26" as="geometry"/></mxCell>
<mxCell id="step1" value="&lt;b style='font-size:14px'&gt;Readiness GO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Autopilot and the Readiness agent confirm replication health; a drill starts only on a recent GO." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingLeft=46;spacingTop=14;spacingRight=12;" parent="L_notes" vertex="1"><mxGeometry x="228" y="885" width="310" height="165" as="geometry"/></mxCell>
<mxCell id="step1_n" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;align=center;verticalAlign=middle;" parent="L_notes" vertex="1"><mxGeometry x="240" y="899" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="step2" value="&lt;b style='font-size:14px'&gt;Plan approved&lt;/b&gt;&lt;br&gt;&lt;br&gt;Planner and Runbook agents draft the exercise; a human approver signs off before any outage." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingLeft=46;spacingTop=14;spacingRight=12;" parent="L_notes" vertex="1"><mxGeometry x="558" y="885" width="310" height="165" as="geometry"/></mxCell>
<mxCell id="step2_n" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;align=center;verticalAlign=middle;" parent="L_notes" vertex="1"><mxGeometry x="570" y="899" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="step3" value="&lt;b style='font-size:14px'&gt;Outage injected&lt;/b&gt;&lt;br&gt;&lt;br&gt;Engine stops the Region A App Service (dra-app-eas-e23x) through Azure Resource Manager." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingLeft=46;spacingTop=14;spacingRight=12;" parent="L_notes" vertex="1"><mxGeometry x="888" y="885" width="310" height="165" as="geometry"/></mxCell>
<mxCell id="step3_n" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;align=center;verticalAlign=middle;" parent="L_notes" vertex="1"><mxGeometry x="900" y="899" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="step4" value="&lt;b style='font-size:14px'&gt;SQL failover&lt;/b&gt;&lt;br&gt;&lt;br&gt;Engine fails over group dra-fog-e23x; the Southeast Asia replica becomes primary." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontFamily=Segoe UI,Helvetica,Arial,sans-serif;fontSize=12;fontColor=#201F1E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;spacingLeft=46;spacingTop=14;spacingRight=12;" parent="L_notes" vertex="1"><mxGeometry x="228" y="1070" width="310" height="165" as="geometry"/></mxCell>
